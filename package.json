    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.7.0",
    "vite": "^5.0.11",
    "vue-tsc": "^2.2.0"
  }
}
